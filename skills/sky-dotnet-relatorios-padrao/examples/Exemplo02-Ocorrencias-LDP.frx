<?xml version="1.0" encoding="utf-8"?>
<!--
  Exemplo02-Ocorrencias-LDP.frx
  Padrão visual Sky (skills/sky-dotnet-relatorios-padrao/references/padrao-visual-relatorios.md)
  Variante: SOMENTE GRUPO (grupo por tipo_ocorrencia + detalhe + TOTAL GRUPO linha única + TOTAL GERAL)
  Units = Centimeters | A4 | margens 1.5 cm
  Alturas de banda (grid 8 pt => cm): grupo 0.85 / cabeçalho colunas 0.56 / detalhe 0.56 / total grupo 0.85 / total geral 0.85
  Texto centralizado verticalmente: VertAlign="Center" + altura do objeto = altura da banda.
-->
<Report ScriptLanguage="CSharp" ReportInfo.CreatorVersion="2025.1.0">
  <Dictionary>
    <BusinessObjectDataSource Name="Ocorrencias" ReferenceName="Ocorrencias" DataType="System.Collections.Generic.IEnumerable`1[[Ocorrencia, Ocorrencia]]" Enabled="true">
      <Column Name="data" DataType="System.String"/>
      <Column Name="tipo_ocorrencia" DataType="System.String"/>
      <Column Name="origem" DataType="System.String"/>
      <Column Name="nota_entrega" DataType="System.String"/>
      <Column Name="protocolos" DataType="System.String"/>
      <Column Name="numerorecibo" DataType="System.String"/>
      <Column Name="valor" DataType="System.Decimal"/>
    </BusinessObjectDataSource>
  </Dictionary>
  <ReportPage Name="Page1" PaperSize="A4" PaperWidth="21" PaperHeight="29.7" LeftMargin="1.5" RightMargin="1.5" TopMargin="1.5" BottomMargin="1.5" MirrorMargins="false">
    <ReportTitleBand Name="ReportTitle1" Width="18" Height="0.5"/>
    <PageHeaderBand Name="PageHeader1" Width="18" Height="2.4">
      <TextObject Name="Titulo" Left="0" Top="0" Width="18" Height="0.7" Font="Arial, 14pt, style=Bold" Text="OCORRÊNCIAS — LIVRO DIÁRIO DE PREVENÇÃO (LDP)"/>
      <TextObject Name="Subtitulo" Left="0" Top="0.75" Width="18" Height="0.45" Font="Arial, 9pt" Text="Demonstrativo de ocorrências do depósito — Nota de Entrega 565339-A"/>
      <LineObject Name="LinhaSub" StartPoint="0, 1.55" EndPoint="18, 1.55" LineColor="Gray" LineWidth="0.75"/>
      <TextObject Name="FiltroRotulo" Left="0" Top="1.7" Width="0.95" Height="0.4" Font="Arial, 7.5pt, style=Bold" TextColor="Gray" Text="Período:"/>
      <TextObject Name="FiltroValor" Left="0.95" Top="1.7" Width="12" Height="0.4" Font="Arial, 7.5pt" TextColor="Gray" Text=" 19/05/2025 a 16/07/2026   •   Processo: 565339-A   •   Protocolo: 523101"/>
      <TextObject Name="Moeda" Left="16" Top="1.7" Width="2" Height="0.4" Font="Arial, 7.5pt" HorizAlign="Right" Text="BRL (R$)"/>
      <LineObject Name="LinhaFiltros" StartPoint="0, 2.25" EndPoint="18, 2.25" LineColor="Gray" LineWidth="0.75"/>
    </PageHeaderBand>
    <GroupHeaderBand Name="GroupHeader1" Condition="[Ocorrencias.tipo_ocorrencia]" Width="18" Height="0.85">
      <TextObject Name="GrupoNome" Left="0" Top="0" Width="18" Height="0.85" Font="Arial, 10.5pt, style=Bold" VertAlign="Center" Text="[Ocorrencias.tipo_ocorrencia].ToUpper()"/>
    </GroupHeaderBand>
    <HeaderBand Name="HeaderColunas" Width="18" Height="0.56">
      <LineObject Name="LinhaColTopo" StartPoint="0, 0" EndPoint="18, 0" LineColor="Black" LineWidth="0.75"/>
      <TextObject Name="ColData" Left="0" Top="0" Width="1.95" Height="0.56" Font="Arial, 7.5pt, style=Bold" VertAlign="Center" Text="DATA"/>
      <TextObject Name="ColOrigem" Left="1.95" Top="0" Width="4.75" Height="0.56" Font="Arial, 7.5pt, style=Bold" VertAlign="Center" Text="ORIGEM"/>
      <TextObject Name="ColNota" Left="6.7" Top="0" Width="2.75" Height="0.56" Font="Arial, 7.5pt, style=Bold" VertAlign="Center" Text="NOTA ENTREGA"/>
      <TextObject Name="ColProtocolo" Left="9.45" Top="0" Width="2.65" Height="0.56" Font="Arial, 7.5pt, style=Bold" VertAlign="Center" Text="PROTOCOLO"/>
      <TextObject Name="ColRecibo" Left="12.1" Top="0" Width="3.9" Height="0.56" Font="Arial, 7.5pt, style=Bold" VertAlign="Center" Text="RECIBO"/>
      <TextObject Name="ColValor" Left="16" Top="0" Width="2" Height="0.56" Font="Arial, 7.5pt, style=Bold" VertAlign="Center" HorizAlign="Right" Text="VALOR"/>
      <LineObject Name="LinhaColBase" StartPoint="0, 0.55" EndPoint="18, 0.55" LineColor="Black" LineWidth="0.75"/>
    </HeaderBand>
    <DataBand Name="Data1" DataSource="Ocorrencias" Width="18" Height="0.56">
      <TextObject Name="DetData" Left="0" Top="0" Width="1.95" Height="0.56" Font="Arial, 8pt" VertAlign="Center" Text="[Ocorrencias.data]"/>
      <TextObject Name="DetOrigem" Left="1.95" Top="0" Width="4.75" Height="0.56" Font="Arial, 8pt" VertAlign="Center" Text="[Ocorrencias.origem]"/>
      <TextObject Name="DetNota" Left="6.7" Top="0" Width="2.75" Height="0.56" Font="Arial, 8pt" VertAlign="Center" Text="[Ocorrencias.nota_entrega]"/>
      <TextObject Name="DetProtocolo" Left="9.45" Top="0" Width="2.65" Height="0.56" Font="Arial, 8pt" VertAlign="Center" Text="[Ocorrencias.protocolos]"/>
      <TextObject Name="DetRecibo" Left="12.1" Top="0" Width="3.9" Height="0.56" Font="Arial, 8pt" VertAlign="Center" Text="[Ocorrencias.numerorecibo]"/>
      <TextObject Name="DetValor" Left="16" Top="0" Width="2" Height="0.56" Font="Arial, 8pt" VertAlign="Center" HorizAlign="Right" Format="N2" Text="[Ocorrencias.valor]"/>
    </DataBand>
    <GroupFooterBand Name="GroupFooter1" Width="18" Height="0.85">
      <LineObject Name="LinhaTotalGrupoTopo" StartPoint="0, 0" EndPoint="18, 0" LineColor="Gray" LineWidth="0.75"/>
      <TextObject Name="TotalGrupoRotulo" Left="0" Top="0" Width="12" Height="0.85" Font="Arial, 8pt, style=Bold" VertAlign="Center" Text="TOTAL GRUPO"/>
      <TextObject Name="TotalGrupoValor" Left="12" Top="0" Width="6" Height="0.85" Font="Arial, 8pt, style=Bold" VertAlign="Center" HorizAlign="Right" Format="N2" Text="R$ [Sum(Ocorrencias.valor)]"/>
      <LineObject Name="LinhaTotalGrupoBase" StartPoint="0, 0.84" EndPoint="18, 0.84" LineColor="Gray" LineWidth="0.75"/>
    </GroupFooterBand>
    <ReportSummaryBand Name="ReportSummary1" Width="18" Height="0.85">
      <LineObject Name="LinhaTotalGeralTopo" StartPoint="0, 0" EndPoint="18, 0" LineColor="Black" LineWidth="0.75"/>
      <TextObject Name="TotalGeralRotulo" Left="0" Top="0" Width="12" Height="0.85" Font="Arial, 9.5pt, style=Bold" VertAlign="Center" Text="TOTAL GERAL DO RELATÓRIO"/>
      <TextObject Name="TotalGeralValor" Left="12" Top="0" Width="6" Height="0.85" Font="Arial, 10pt, style=Bold" VertAlign="Center" HorizAlign="Right" Format="N2" Text="R$ [Sum(Ocorrencias.valor)]"/>
      <LineObject Name="LinhaTotalGeralBase1" StartPoint="0, 0.84" EndPoint="18, 0.84" LineColor="Black" LineWidth="0.75"/>
      <LineObject Name="LinhaTotalGeralBase2" StartPoint="0, 0.847" EndPoint="18, 0.847" LineColor="Black" LineWidth="0.75"/>
    </ReportSummaryBand>
    <PageFooterBand Name="PageFooter1" Width="18" Height="1">
      <LineObject Name="LinhaRodape" StartPoint="0, 0" EndPoint="18, 0" LineColor="Gray" LineWidth="0.75"/>
      <TextObject Name="RodapeData" Left="0" Top="0.15" Width="6" Height="0.4" Font="Arial, 8pt" Text="Emissão: 02/10/2026 16:00"/>
      <TextObject Name="RodapeOperador" Left="6" Top="0.15" Width="6" Height="0.4" Font="Arial, 8pt" HorizAlign="Center" Text="Operador: SISTEMA"/>
      <TextObject Name="RodapePagina" Left="12" Top="0.15" Width="6" Height="0.4" Font="Arial, 8pt" HorizAlign="Right" Text="Página [PageN] de [TotalPages]"/>
    </PageFooterBand>
  </ReportPage>
</Report>