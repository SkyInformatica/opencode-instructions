<?xml version="1.0" encoding="utf-8"?>
<!--
  Exemplo03-Depositos-LDP-GeradoPelaSkill.frx
  Padrão visual Sky — variante SOMENTE GRUPO (sem subgrupo)
  Grupo: nota_entrega. 4 colunas de valor (VALOR/SALDO/CONVERTIDO/RESTITUÍDO).
  Total de grupo/geral: LABEL em cima e VALORES embaixo, cada um alinhado
  na borda direita da própria coluna (bloco 32pt = 1.13cm).
  Units = Centimeters | A4 | margens 1.5cm
-->
<Report ScriptLanguage="CSharp" ReportInfo.CreatorVersion="2025.1.0">
  <Dictionary>
    <BusinessObjectDataSource Name="Depositos" ReferenceName="Depositos" DataType="System.Collections.Generic.IEnumerable`1[[Deposito, Deposito]]" Enabled="true">
      <Column Name="nota_entrega" DataType="System.String"/>
      <Column Name="recibo" DataType="System.String"/>
      <Column Name="data_entrada" DataType="System.String"/>
      <Column Name="valor" DataType="System.Decimal"/>
      <Column Name="status" DataType="System.String"/>
      <Column Name="saldo" DataType="System.Decimal"/>
      <Column Name="convertido" DataType="System.Decimal"/>
      <Column Name="restituido" DataType="System.Decimal"/>
    </BusinessObjectDataSource>
  </Dictionary>
  <ReportPage Name="Page1" PaperSize="A4" PaperWidth="21" PaperHeight="29.7" LeftMargin="1.5" RightMargin="1.5" TopMargin="1.5" BottomMargin="1.5">
    <ReportTitleBand Name="ReportTitle1" Width="18" Height="0.5"/>
    <PageHeaderBand Name="PageHeader1" Width="18" Height="2.4">
      <TextObject Name="Titulo" Left="0" Top="0" Width="18" Height="0.7" Font="Arial, 14pt, style=Bold" Text="DEPÓSITOS — LIVRO DIÁRIO DE PREVENÇÃO (LDP)"/>
      <TextObject Name="Subtitulo" Left="0" Top="0.75" Width="18" Height="0.45" Font="Arial, 9pt" Text="Depósitos agrupados por nota de entrega"/>
      <LineObject Name="LinhaSub" StartPoint="0, 1.55" EndPoint="18, 1.55" LineColor="Gray" LineWidth="0.75"/>
      <TextObject Name="FiltroRotulo" Left="0" Top="1.7" Width="0.95" Height="0.4" Font="Arial, 7.5pt, style=Bold" TextColor="Gray" Text="Período:"/>
      <TextObject Name="FiltroValor" Left="0.95" Top="1.7" Width="12" Height="0.4" Font="Arial, 7.5pt" TextColor="Gray" Text=" 03/03/2026 a 03/03/2026   •   Posição dos depósitos e conversões"/>
      <LineObject Name="LinhaFiltros" StartPoint="0, 2.25" EndPoint="18, 2.25" LineColor="Gray" LineWidth="0.75"/>
    </PageHeaderBand>
    <GroupHeaderBand Name="GroupHeader1" Condition="[Depositos.nota_entrega]" Width="18" Height="0.85">
      <TextObject Name="GrupoNome" Left="0" Top="0" Width="18" Height="0.85" Font="Arial, 10.5pt, style=Bold" VertAlign="Center" Text="NOTA DE ENTREGA [Depositos.nota_entrega]"/>
    </GroupHeaderBand>
    <HeaderBand Name="HeaderColunas" Width="18" Height="0.56">
      <LineObject Name="LinhaColTopo" StartPoint="0.48, 0" EndPoint="18, 0" LineColor="Black" LineWidth="0.75"/>
      <TextObject Name="ColRecibo" Left="0.48" Top="0" Width="2.79" Height="0.56" Font="Arial, 7.5pt, style=Bold" VertAlign="Center" Text="RECIBO"/>
      <TextObject Name="ColDataEntrada" Left="4.14" Top="0" Width="3.18" Height="0.56" Font="Arial, 7.5pt, style=Bold" VertAlign="Center" Text="DATA ENTRADA"/>
      <TextObject Name="ColStatus" Left="7.32" Top="0" Width="3.18" Height="0.56" Font="Arial, 7.5pt, style=Bold" VertAlign="Center" Text="STATUS"/>
      <TextObject Name="ColValor" Left="10.9" Top="0" Width="1.18" Height="0.56" Font="Arial, 7.5pt, style=Bold" VertAlign="Center" HorizAlign="Right" Text="VALOR"/>
      <TextObject Name="ColSaldo" Left="13.2" Top="0" Width="1.0" Height="0.56" Font="Arial, 7.5pt, style=Bold" VertAlign="Center" HorizAlign="Right" Text="SALDO"/>
      <TextObject Name="ColConvertido" Left="15.3" Top="0" Width="1.01" Height="0.56" Font="Arial, 7.5pt, style=Bold" VertAlign="Center" HorizAlign="Right" Text="CONVERTIDO"/>
      <TextObject Name="ColRestituido" Left="16.9" Top="0" Width="1.08" Height="0.56" Font="Arial, 7.5pt, style=Bold" VertAlign="Center" HorizAlign="Right" Text="RESTITUÍDO"/>
      <LineObject Name="LinhaColBase" StartPoint="0.48, 0.55" EndPoint="18, 0.55" LineColor="Black" LineWidth="0.75"/>
    </HeaderBand>
    <DataBand Name="Data1" DataSource="Depositos" Width="18" Height="0.56">
      <TextObject Name="DetRecibo" Left="0.48" Top="0" Width="2.79" Height="0.56" Font="Arial, 8pt" VertAlign="Center" WordWrap="True" Text="[Depositos.recibo]"/>
      <TextObject Name="DetDataEntrada" Left="4.14" Top="0" Width="3.18" Height="0.56" Font="Arial, 8pt" VertAlign="Center" Text="[Depositos.data_entrada]"/>
      <TextObject Name="DetStatus" Left="7.32" Top="0" Width="3.18" Height="0.56" Font="Arial, 8pt" VertAlign="Center" Text="[Depositos.status]"/>
      <TextObject Name="DetValor" Left="10.9" Top="0" Width="1.18" Height="0.56" Font="Arial, 8pt" VertAlign="Center" HorizAlign="Right" Format="N2" Text="[Depositos.valor]"/>
      <TextObject Name="DetSaldo" Left="13.2" Top="0" Width="1.0" Height="0.56" Font="Arial, 8pt" VertAlign="Center" HorizAlign="Right" Format="N2" Text="[Depositos.saldo]"/>
      <TextObject Name="DetConvertido" Left="15.3" Top="0" Width="1.01" Height="0.56" Font="Arial, 8pt" VertAlign="Center" HorizAlign="Right" Format="N2" Text="[Depositos.convertido]"/>
      <TextObject Name="DetRestituido" Left="16.9" Top="0" Width="1.08" Height="0.56" Font="Arial, 8pt" VertAlign="Center" HorizAlign="Right" Format="N2" Text="[Depositos.restituido]"/>
    </DataBand>
    <GroupFooterBand Name="GroupFooter1" Width="18" Height="1.69">
      <LineObject Name="LinhaTotalGrupoTopo" StartPoint="0.48, 0" EndPoint="18, 0" LineColor="Gray" LineWidth="0.75"/>
      <TextObject Name="TotalGrupoRotulo" Left="0.48" Top="0.25" Width="11" VertAlign="Center" Height="0.5" Font="Arial, 8.5pt, style=Bold" Text="TOTAL GRUPO NOTA DE ENTREGA [Depositos.nota_entrega]"/>
      <TextObject Name="TotalGrupoHdConvertido" Left="15.3" Top="0.67" Width="1.01" VertAlign="Center" Height="0.35" Font="Arial, 7pt, style=Bold" HorizAlign="Right" Text="CONVERTIDO"/>
      <TextObject Name="TotalGrupoHdRestituido" Left="16.9" Top="0.67" Width="1.08" VertAlign="Center" Height="0.35" Font="Arial, 7pt, style=Bold" HorizAlign="Right" Text="RESTITUÍDO"/>
      <TextObject Name="TotalGrupoConvertido" Left="15.3" Top="0.89" Width="1.01" VertAlign="Center" Height="0.6" Font="Arial, 8pt, style=Bold" HorizAlign="Right" Format="N2" Text="R$ [Sum(Depositos.convertido)]"/>
      <TextObject Name="TotalGrupoRestituido" Left="16.9" Top="0.89" Width="1.08" VertAlign="Center" Height="0.6" Font="Arial, 8pt, style=Bold" HorizAlign="Right" Format="N2" Text="R$ [Sum(Depositos.restituido)]"/>
      <LineObject Name="LinhaTotalGrupoBase" StartPoint="0.48, 1.68" EndPoint="18, 1.68" LineColor="Gray" LineWidth="0.75"/>
    </GroupFooterBand>
    <ReportSummaryBand Name="ReportSummary1" Width="18" Height="1.69">
      <LineObject Name="LinhaTotalGeralTopo" StartPoint="0.48, 0" EndPoint="18, 0" LineColor="Black" LineWidth="0.75"/>
      <TextObject Name="TotalGeralRotulo" Left="0.48" Top="0.25" Width="10" VertAlign="Center" Height="0.5" Font="Arial, 9.5pt, style=Bold" Text="TOTAL GERAL DO RELATÓRIO"/>
      <TextObject Name="TotalGeralHdValor" Left="10.9" Top="0.67" Width="1.18" VertAlign="Center" Height="0.35" Font="Arial, 7pt, style=Bold" HorizAlign="Right" Text="VALOR"/>
      <TextObject Name="TotalGeralHdSaldo" Left="13.2" Top="0.67" Width="1.0" VertAlign="Center" Height="0.35" Font="Arial, 7pt, style=Bold" HorizAlign="Right" Text="SALDO"/>
      <TextObject Name="TotalGeralHdConvertido" Left="15.3" Top="0.67" Width="1.01" VertAlign="Center" Height="0.35" Font="Arial, 7pt, style=Bold" HorizAlign="Right" Text="CONVERTIDO"/>
      <TextObject Name="TotalGeralHdRestituido" Left="16.9" Top="0.67" Width="1.08" VertAlign="Center" Height="0.35" Font="Arial, 7pt, style=Bold" HorizAlign="Right" Text="RESTITUÍDO"/>
      <TextObject Name="TotalGeralValor" Left="10.9" Top="0.89" Width="1.18" VertAlign="Center" Height="0.6" Font="Arial, 10pt, style=Bold" HorizAlign="Right" Format="N2" Text="R$ [Sum(Depositos.valor)]"/>
      <TextObject Name="TotalGeralSaldo" Left="13.2" Top="0.89" Width="1.0" VertAlign="Center" Height="0.6" Font="Arial, 10pt, style=Bold" HorizAlign="Right" Format="N2" Text="R$ [Sum(Depositos.saldo)]"/>
      <TextObject Name="TotalGeralConvertido" Left="15.3" Top="0.89" Width="1.01" VertAlign="Center" Height="0.6" Font="Arial, 10pt, style=Bold" HorizAlign="Right" Format="N2" Text="R$ [Sum(Depositos.convertido)]"/>
      <TextObject Name="TotalGeralRestituido" Left="16.9" Top="0.89" Width="1.08" VertAlign="Center" Height="0.6" Font="Arial, 10pt, style=Bold" HorizAlign="Right" Format="N2" Text="R$ [Sum(Depositos.restituido)]"/>
      <LineObject Name="LinhaTotalGeralBase" StartPoint="0.48, 1.68" EndPoint="18, 1.68" LineColor="Black" LineWidth="0.75"/>
    </ReportSummaryBand>
    <PageFooterBand Name="PageFooter1" Width="18" Height="1">
      <LineObject Name="LinhaRodape" StartPoint="0, 0" EndPoint="18, 0" LineColor="Gray" LineWidth="0.75"/>
      <TextObject Name="RodapeData" Left="0" Top="0.15" Width="6" Height="0.4" Font="Arial, 8pt" TextColor="Gray" Text="Emissão: 02/10/2026 16:00"/>
      <TextObject Name="RodapeOperador" Left="6" Top="0.15" Width="6" Height="0.4" Font="Arial, 8pt" TextColor="Gray" HorizAlign="Center" Text="Operador: SISTEMA"/>
      <TextObject Name="RodapePagina" Left="12" Top="0.15" Width="6" Height="0.4" Font="Arial, 8pt" TextColor="Gray" HorizAlign="Right" Text="Página [PageN] de [TotalPages]"/>
    </PageFooterBand>
  </ReportPage>
</Report>