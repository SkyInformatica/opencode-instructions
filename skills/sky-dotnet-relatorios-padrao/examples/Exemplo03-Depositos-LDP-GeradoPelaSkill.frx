<?xml version="1.0" encoding="utf-8"?>
<!--
  Exemplo03-Depositos-LDP-GeradoPelaSkill.frx
  Padrão visual Sky (padrao-visual-relatorios.md) — variante SOMENTE GRUPO
  Grupo por comprovante (depósito). Units = Centimeters | A4 | margens 1.5cm
  Alturas (grid 8pt => cm): grupo 0.85 / cabeçalho 0.56 / detalhe 0.56 / total grupo 0.85 / total geral 0.85
  Texto centralizado verticalmente (VertAlign="Center", altura objeto = banda).
  Coluna RECIBO estreita (2.79cm) + WordWrap: conteúdo longo quebra em 2 linhas (banda 32pt).
-->
<Report ScriptLanguage="CSharp" ReportInfo.CreatorVersion="2025.1.0">
  <Dictionary>
    <BusinessObjectDataSource Name="Depositos" ReferenceName="Depositos" DataType="System.Collections.Generic.IEnumerable`1[[Deposito, Deposito]]" Enabled="true">
      <Column Name="comprovante" DataType="System.String"/>
      <Column Name="recibo" DataType="System.String"/>
      <Column Name="data_entrada" DataType="System.String"/>
      <Column Name="valor" DataType="System.Decimal"/>
      <Column Name="status" DataType="System.String"/>
      <Column Name="saldo" DataType="System.Decimal"/>
      <Column Name="convertido" DataType="System.Decimal"/>
      <Column Name="restituido" DataType="System.Decimal"/>
    </BusinessObjectDataSource>
  </Dictionary>
  <ReportPage Name="Page1" PaperSize="A4" PaperWidth="21" PaperHeight="29.7" LeftMargin="1.5" RightMargin="1.5" TopMargin="1.5" BottomMargin="1.5">
    <ReportTitleBand Name="ReportTitle1" Width="18" Height="0.5"/>
    <PageHeaderBand Name="PageHeader1" Width="18" Height="2.4">
      <TextObject Name="Titulo" Left="0" Top="0" Width="18" Height="0.7" Font="Arial, 14pt, style=Bold" Text="DEPÓSITOS — LIVRO DIÁRIO DE PREVENÇÃO (LDP)"/>
      <TextObject Name="Subtitulo" Left="0" Top="0.75" Width="18" Height="0.45" Font="Arial, 9pt" Text="Movimentação de depósitos — Nota de Entrega 586746-A"/>
      <LineObject Name="LinhaSub" StartPoint="0, 1.55" EndPoint="18, 1.55" LineColor="Gray" LineWidth="0.75"/>
      <TextObject Name="FiltroRotulo" Left="0" Top="1.7" Width="0.95" Height="0.4" Font="Arial, 7.5pt, style=Bold" TextColor="Gray" Text="Período:"/>
      <TextObject Name="FiltroValor" Left="0.95" Top="1.7" Width="12" Height="0.4" Font="Arial, 7.5pt" TextColor="Gray" Text=" 01/10/2025 a 10/10/2025   •   Processo: 586746-A   •   Protocolo: 532574"/>
      <LineObject Name="LinhaFiltros" StartPoint="0, 2.25" EndPoint="18, 2.25" LineColor="Gray" LineWidth="0.75"/>
    </PageHeaderBand>
    <GroupHeaderBand Name="GroupHeader1" Condition="[Depositos.comprovante]" Width="18" Height="0.85">
      <TextObject Name="GrupoNome" Left="0" Top="0" Width="18" Height="0.85" Font="Arial, 10.5pt, style=Bold" VertAlign="Center" Text="COMPROVANTE [Depositos.comprovante]"/>
    </GroupHeaderBand>
    <HeaderBand Name="HeaderColunas" Width="18" Height="0.56">
      <LineObject Name="LinhaColTopo" StartPoint="0, 0" EndPoint="18, 0" LineColor="Black" LineWidth="0.75"/>
      <TextObject Name="ColRecibo" Left="0" Top="0" Width="2.79" Height="0.56" Font="Arial, 7.5pt, style=Bold" VertAlign="Center" Text="RECIBO"/>
      <TextObject Name="ColDataEntrada" Left="2.8" Top="0" Width="3.1" Height="0.56" Font="Arial, 7.5pt, style=Bold" VertAlign="Center" Text="DATA ENTRADA"/>
      <TextObject Name="ColStatus" Left="5.9" Top="0" Width="3.1" Height="0.56" Font="Arial, 7.5pt, style=Bold" VertAlign="Center" Text="STATUS"/>
      <TextObject Name="ColValor" Left="9.6" Top="0" Width="1.24" Height="0.56" Font="Arial, 7.5pt, style=Bold" VertAlign="Center" HorizAlign="Right" Text="VALOR"/>
      <TextObject Name="ColSaldo" Left="12.2" Top="0" Width="1.11" Height="0.56" Font="Arial, 7.5pt, style=Bold" VertAlign="Center" HorizAlign="Right" Text="SALDO"/>
      <TextObject Name="ColConvertido" Left="14.7" Top="0" Width="1.08" Height="0.56" Font="Arial, 7.5pt, style=Bold" VertAlign="Center" HorizAlign="Right" Text="CONVERTIDO"/>
      <TextObject Name="ColRestituido" Left="16.9" Top="0" Width="1.08" Height="0.56" Font="Arial, 7.5pt, style=Bold" VertAlign="Center" HorizAlign="Right" Text="RESTITUÍDO"/>
      <LineObject Name="LinhaColBase" StartPoint="0, 0.55" EndPoint="18, 0.55" LineColor="Black" LineWidth="0.75"/>
    </HeaderBand>
    <DataBand Name="Data1" DataSource="Depositos" Width="18" Height="0.56">
      <TextObject Name="DetRecibo" Left="0" Top="0" Width="2.79" Height="0.56" Font="Arial, 8pt" VertAlign="Center" WordWrap="True" Text="[Depositos.recibo]"/>
      <TextObject Name="DetDataEntrada" Left="2.8" Top="0" Width="3.1" Height="0.56" Font="Arial, 8pt" VertAlign="Center" Text="[Depositos.data_entrada]"/>
      <TextObject Name="DetStatus" Left="5.9" Top="0" Width="3.1" Height="0.56" Font="Arial, 8pt" VertAlign="Center" Text="[Depositos.status]"/>
      <TextObject Name="DetValor" Left="9.6" Top="0" Width="1.24" Height="0.56" Font="Arial, 8pt" VertAlign="Center" HorizAlign="Right" Format="N2" Text="[Depositos.valor]"/>
      <TextObject Name="DetSaldo" Left="12.2" Top="0" Width="1.11" Height="0.56" Font="Arial, 8pt" VertAlign="Center" HorizAlign="Right" Format="N2" Text="[Depositos.saldo]"/>
      <TextObject Name="DetConvertido" Left="14.7" Top="0" Width="1.08" Height="0.56" Font="Arial, 8pt" VertAlign="Center" HorizAlign="Right" Format="N2" Text="[Depositos.convertido]"/>
      <TextObject Name="DetRestituido" Left="16.9" Top="0" Width="1.08" Height="0.56" Font="Arial, 8pt" VertAlign="Center" HorizAlign="Right" Format="N2" Text="[Depositos.restituido]"/>
    </DataBand>
    <GroupFooterBand Name="GroupFooter1" Width="18" Height="0.85">
      <LineObject Name="LinhaTotalGrupoTopo" StartPoint="0, 0" EndPoint="18, 0" LineColor="Gray" LineWidth="0.75"/>
      <TextObject Name="TotalGrupoRotulo" Left="0" Top="0" Width="12" Height="0.85" Font="Arial, 8pt, style=Bold" VertAlign="Center" Text="TOTAL GRUPO"/>
      <TextObject Name="TotalGrupoValor" Left="12" Top="0" Width="6" Height="0.85" Font="Arial, 8pt, style=Bold" VertAlign="Center" HorizAlign="Right" Format="N2" Text="R$ [Sum(Depositos.valor)]"/>
      <LineObject Name="LinhaTotalGrupoBase" StartPoint="0, 0.84" EndPoint="18, 0.84" LineColor="Gray" LineWidth="0.75"/>
    </GroupFooterBand>
    <ReportSummaryBand Name="ReportSummary1" Width="18" Height="0.85">
      <LineObject Name="LinhaTotalGeralTopo" StartPoint="0, 0" EndPoint="18, 0" LineColor="Black" LineWidth="0.75"/>
      <TextObject Name="TotalGeralRotulo" Left="0" Top="0" Width="12" Height="0.85" Font="Arial, 9.5pt, style=Bold" VertAlign="Center" Text="TOTAL GERAL DO RELATÓRIO"/>
      <TextObject Name="TotalGeralValor" Left="12" Top="0" Width="6" Height="0.85" Font="Arial, 10pt, style=Bold" VertAlign="Center" HorizAlign="Right" Format="N2" Text="R$ [Sum(Depositos.valor)]"/>
      <LineObject Name="LinhaTotalGeralBase" StartPoint="0, 0.84" EndPoint="18, 0.84" LineColor="Black" LineWidth="0.75"/>
    </ReportSummaryBand>
    <PageFooterBand Name="PageFooter1" Width="18" Height="1">
      <LineObject Name="LinhaRodape" StartPoint="0, 0" EndPoint="18, 0" LineColor="Gray" LineWidth="0.75"/>
      <TextObject Name="RodapeData" Left="0" Top="0.15" Width="6" Height="0.4" Font="Arial, 8pt" TextColor="Gray" Text="Emissão: 02/10/2026 16:00"/>
      <TextObject Name="RodapeOperador" Left="6" Top="0.15" Width="6" Height="0.4" Font="Arial, 8pt" TextColor="Gray" HorizAlign="Center" Text="Operador: SISTEMA"/>
      <TextObject Name="RodapePagina" Left="12" Top="0.15" Width="6" Height="0.4" Font="Arial, 8pt" TextColor="Gray" HorizAlign="Right" Text="Página [PageN] de [TotalPages]"/>
    </PageFooterBand>
  </ReportPage>
</Report>