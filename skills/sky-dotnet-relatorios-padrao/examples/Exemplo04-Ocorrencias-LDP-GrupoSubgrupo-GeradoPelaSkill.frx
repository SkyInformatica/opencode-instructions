<?xml version="1.0" encoding="utf-8"?>
<!--
  Exemplo04-Ocorrencias-LDP-GrupoSubgrupo-GeradoPelaSkill.frx
  Padrão visual Sky — variante GRUPO + SUBGRUPO
  Grupo: nota_entrega | Subgrupo: tipo_ocorrencia
  Indentação: conteúdo sob o grupo em +0.48cm (13.5pt); grupo na margem.
  Linhas de borda das bandas de conteúdo de 0.48..18; sob o grupo e rodapé full-width.
  Total de subgrupo: banda 0.85cm (16pt + 8pt de respiro antes do próximo subgrupo).
  Units = Centimeters | A4 | margens 1.5cm
-->
<Report ScriptLanguage="CSharp" ReportInfo.CreatorVersion="2025.1.0">
  <Dictionary>
    <BusinessObjectDataSource Name="Ocorrencias" ReferenceName="Ocorrencias" DataType="System.Collections.Generic.IEnumerable`1[[Ocorrencia, Ocorrencia]]" Enabled="true">
      <Column Name="data" DataType="System.String"/>
      <Column Name="tipo_ocorrencia" DataType="System.String"/>
      <Column Name="origem" DataType="System.String"/>
      <Column Name="protocolos" DataType="System.String"/>
      <Column Name="numerorecibo" DataType="System.String"/>
      <Column Name="nota_entrega" DataType="System.String"/>
      <Column Name="valor" DataType="System.Decimal"/>
    </BusinessObjectDataSource>
  </Dictionary>
  <ReportPage Name="Page1" PaperSize="A4" PaperWidth="21" PaperHeight="29.7" LeftMargin="1.5" RightMargin="1.5" TopMargin="1.5" BottomMargin="1.5">
    <ReportTitleBand Name="ReportTitle1" Width="18" Height="0.5"/>
    <PageHeaderBand Name="PageHeader1" Width="18" Height="2.47">
      <TextObject Name="Titulo" Left="0" Top="0" Width="18" Height="0.7" Font="Arial, 14pt, style=Bold" Text="OCORRÊNCIAS — LIVRO DIÁRIO DE PREVENÇÃO (LDP)"/>
      <TextObject Name="Subtitulo" Left="0" Top="0.75" Width="18" Height="0.45" Font="Arial, 9pt" Text="Agrupado por nota de entrega e tipo de ocorrência"/>
      <LineObject Name="LinhaSub" StartPoint="0, 1.35" EndPoint="18, 1.35" LineColor="Gray" LineWidth="0.75"/>
      <TextObject Name="FiltroRotulo" Left="0" Top="1.35" Width="1.2" Height="0.56" VertAlign="Center" Font="Arial, 7.5pt, style=Bold" TextColor="Gray" Text="Período:"/>
      <TextObject Name="FiltroValor" Left="1.2" Top="1.35" Width="12" Height="0.56" VertAlign="Center" Font="Arial, 7.5pt" TextColor="89, 89, 89" Text=" 04/05/2026   •   Natureza: ocorrências de depósito"/>
      <LineObject Name="LinhaFiltros" StartPoint="0, 1.91" EndPoint="18, 1.91" LineColor="Gray" LineWidth="0.75"/>
    </PageHeaderBand>

    <GroupHeaderBand Name="GroupNota" Condition="[Ocorrencias.nota_entrega]" Width="18" Height="0.85">
      <TextObject Name="GrupoNome" Left="0" Top="0" Width="18" Height="0.85" Font="Arial, 10.5pt, style=Bold" VertAlign="Center" Text="NOTA DE ENTREGA [Ocorrencias.nota_entrega]"/>
      <LineObject Name="LinhaSobGrupo" StartPoint="0, 0.84" EndPoint="18, 0.84" LineColor="Black" LineWidth="0.75"/>
    </GroupHeaderBand>

    <GroupHeaderBand Name="GroupTipo" Condition="[Ocorrencias.tipo_ocorrencia]" Width="18" Height="0.85">
      <TextObject Name="GrupoTipoNome" Left="0.48" Top="0" Width="17.5" Height="0.85" Font="Arial, 8.5pt, style=Bold" TextColor="89, 89, 89" VertAlign="Center" Text="[Ocorrencias.tipo_ocorrencia].ToUpper()"/>
    </GroupHeaderBand>

    <HeaderBand Name="HeaderColunas" Width="18" Height="0.56">
      <LineObject Name="LinhaColTopo" StartPoint="0.48, 0" EndPoint="18, 0" LineColor="Black" LineWidth="0.75"/>
      <TextObject Name="ColData" Left="0.48" Top="0" Width="1.95" Height="0.56" Font="Arial, 7pt, style=Bold" TextColor="89, 89, 89" VertAlign="Center" Text="DATA"/>
      <TextObject Name="ColOrigem" Left="2.43" Top="0" Width="4.65" Height="0.56" Font="Arial, 7pt, style=Bold" TextColor="89, 89, 89" VertAlign="Center" Text="ORIGEM"/>
      <TextObject Name="ColProtocolo" Left="7.8" Top="0" Width="2.45" Height="0.56" Font="Arial, 7pt, style=Bold" TextColor="89, 89, 89" VertAlign="Center" Text="PROTOCOLO"/>
      <TextObject Name="ColRecibo" Left="10.27" Top="0" Width="2.1" Height="0.56" Font="Arial, 7pt, style=Bold" TextColor="89, 89, 89" VertAlign="Center" Text="RECIBO"/>
      <TextObject Name="ColValor" Left="16.9" Top="0" Width="1.1" Height="0.56" Font="Arial, 7pt, style=Bold" TextColor="89, 89, 89" VertAlign="Center" HorizAlign="Right" Text="VALOR"/>
      <LineObject Name="LinhaColBase" StartPoint="0.48, 0.55" EndPoint="18, 0.55" LineColor="Black" LineWidth="0.75"/>
    </HeaderBand>

    <DataBand Name="Data1" DataSource="Ocorrencias" Width="18" Height="0.56">
      <TextObject Name="DetData" Left="0.48" Top="0" Width="1.95" Height="0.56" Font="Arial, 8pt" VertAlign="Center" Text="[Ocorrencias.data]"/>
      <TextObject Name="DetOrigem" Left="2.43" Top="0" Width="4.65" Height="0.56" Font="Arial, 8pt" VertAlign="Center" Text="[Ocorrencias.origem]"/>
      <TextObject Name="DetProtocolo" Left="7.8" Top="0" Width="2.45" Height="0.56" Font="Arial, 8pt" VertAlign="Center" Text="[Ocorrencias.protocolos]"/>
      <TextObject Name="DetRecibo" Left="10.27" Top="0" Width="2.1" Height="0.56" Font="Arial, 8pt" VertAlign="Center" Text="[Ocorrencias.numerorecibo]"/>
      <TextObject Name="DetValor" Left="16.9" Top="0" Width="1.1" Height="0.56" Font="Arial, 8pt" VertAlign="Center" HorizAlign="Right" Format="N2" Text="[Ocorrencias.valor]"/>
    </DataBand>

    <GroupFooterBand Name="FooterTipo" Width="18" Height="0.85">
      <LineObject Name="LinhaTotalSubTopo" StartPoint="0.48, 0" EndPoint="18, 0" LineColor="Gray" LineWidth="0.75"/>
      <TextObject Name="TotalSubRotulo" Left="0.48" Top="0" Width="12" Height="0.85" Font="Arial, 8pt, style=Italic" VertAlign="Center" Text="Total do subgrupo [Ocorrencias.tipo_ocorrencia]"/>
      <TextObject Name="TotalSubValor" Left="12" Top="0" Width="6" Height="0.85" Font="Arial, 8pt, style=Bold" VertAlign="Center" HorizAlign="Right" Format="N2" Text="R$ [Sum(Ocorrencias.valor)]"/>
    </GroupFooterBand>

    <GroupFooterBand Name="FooterNota" Width="18" Height="1.41">
      <LineObject Name="LinhaTotalGrupoTopo" StartPoint="0.48, 0" EndPoint="18, 0" LineColor="Gray" LineWidth="0.75"/>
      <TextObject Name="TotalGrupoRotulo" Left="0.48" Top="0" Width="12" Height="1.13" Font="Arial, 8.5pt" VertAlign="Center" Text="Total do grupo Nota de entrega [Ocorrencias.nota_entrega]"/>
      <TextObject Name="TotalGrupoValor" Left="12" Top="0" Width="6" Height="1.13" Font="Arial, 8pt, style=Bold" VertAlign="Center" HorizAlign="Right" Format="N2" Text="R$ [Sum(Ocorrencias.valor)]"/>
    </GroupFooterBand>

    <ReportSummaryBand Name="ReportSummary1" Width="18" Height="0.85">
      <LineObject Name="LinhaTotalGeralTopo" StartPoint="0, 0" EndPoint="18, 0" LineColor="Black" LineWidth="0.75"/>
      <TextObject Name="TotalGeralRotulo" Left="0" Top="0" Width="12" Height="0.85" Font="Arial, 9.5pt, style=Bold" VertAlign="Center" Text="TOTAL GERAL DO RELATÓRIO"/>
      <TextObject Name="TotalGeralValor" Left="12" Top="0" Width="6" Height="0.85" Font="Arial, 10pt, style=Bold" VertAlign="Center" HorizAlign="Right" Format="N2" Text="R$ [Sum(Ocorrencias.valor)]"/>
      <LineObject Name="LinhaTotalGeralBase" StartPoint="0, 0.84" EndPoint="18, 0.84" LineColor="Black" LineWidth="0.75"/>
    </ReportSummaryBand>

    <PageFooterBand Name="PageFooter1" Width="18" Height="1">
      <LineObject Name="LinhaRodape" StartPoint="0, 0" EndPoint="18, 0" LineColor="Gray" LineWidth="0.75"/>
      <TextObject Name="RodapeData" Left="0" Top="0.15" Width="6" Height="0.4" Font="Arial, 8pt" TextColor="Gray" Text="   Emissão: 02/10/2026 16:00"/>
      <TextObject Name="RodapeOperador" Left="6" Top="0.15" Width="6" Height="0.4" Font="Arial, 8pt" TextColor="Gray" HorizAlign="Center" Text="Operador: SISTEMA"/>
      <TextObject Name="RodapePagina" Left="12" Top="0.15" Width="6" Height="0.4" Font="Arial, 8pt" TextColor="Gray" HorizAlign="Right" Text="Página [PageN] de [TotalPages]   "/>
    </PageFooterBand>
  </ReportPage>
</Report>